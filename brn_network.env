# ============================================================
# brn_network.env — Config do nó BRN
# ============================================================
# Este arquivo é lido no boot pelo main.py.
# Prioridade: env do shell > este arquivo > defaults do main.py
# ============================================================

# ============================================================
# 1) SEGREDOS COMPARTILHADOS (IGUAIS nas duas máquinas)
# ============================================================

# Segredo da rede — HMAC dos auth_tags dos blocos.
# Se trocar, os blocos existentes ficam inválidos. NÃO MUDE.
BRN_NETWORK_SECRET=9226edea8ba62bc1c6ae36883c0536c95b4c85642195465d6c4d9456abef20f9

# Senha do nó (cifra node_identity.enc + miner_wallet.enc).
BRN_NODE_PASSWORD=senha-no-temp-123

# Senha da carteira do usuário (cifra current_wallet.enc).
BRN_WALLET_SESSION_PASS=senha-forte-da-carteira-2026

# Senha do app HTTP (legado, mantida por compat).
BRN_WEB_PASS=senha-temp-123

# ============================================================
# 2) ADMIN TOKEN
# ------------------------------------------------------------
# Protege endpoints admin: /api/mine, /api/faucet, /api/miner/*
# GERE com: python -c "import secrets; print(secrets.token_hex(32))"
# Cole o MESMO valor nas DUAS máquinas.
# Vazio = sem proteção (só para dev).
# ============================================================
BRN_ADMIN_TOKEN=c745d36d524ea92148d8139731ad663f929fbbe08fb7f9b2234f9109fe1d2b24

# ============================================================
# 3) DESCOBERTA DE PEERS
# ============================================================

# IP Tailscale da Ubuntu:6001
# (se for usar Tailscale — veja passo 1 do guia)
BRN_BOOTSTRAP_PEERS=100.64.1.42:6001

# Tracker HTTP — DESLIGADO (Tailscale resolve)
BRN_TRACKER=

# Rendezvous — DESLIGADO
BRN_RENDEZVOUS_URL=

# ============================================================
# 4) MODO DE OPERAÇÃO
# ------------------------------------------------------------
# ⚠️ DIFERE entre as máquinas:
#   Ubuntu  → BRN_IS_ORIGIN=1   (mina, cria genesis)
#   Windows → BRN_IS_ORIGIN=0   (cliente, só sincroniza)
# ============================================================
BRN_IS_ORIGIN=0

# Com 3+ máquinas, DEIXE 0. Senão forks viram regra.
BRN_ALL_MINERS=0

# Auto-mine (minera sozinho no boot). Deixe 0.
BRN_AUTO_MINE=0

# ============================================================
# 5) CONSENSO / DIFICULDADE
# ============================================================
# 6 = ~60s por bloco. Bom para 2-3 nós.
BRN_MIN_DIFFICULTY=6

# Sync em lotes de 50 blocos
BRN_SYNC_BATCH=50
BRN_SYNC_BATCH_DELAY=0.06
BRN_SYNC_INTERVAL=5

# ============================================================
# 6) P2P
# ============================================================
BRN_P2P_PORT=6001
BRN_P2P_AUTH=optional
BRN_P2P_AUTH_WINDOW=30
BRN_P2P_NONCE_CACHE=10000

# Rate limit por IP (msgs/seg). 200 é confortável.
BRN_RATE_LIMIT=200

# UPnP desligado (Tailscale não precisa)
BRN_UPNP=0

BRN_TCP_TIMEOUT=10.0

# ============================================================
# 7) MINERAÇÃO
# ============================================================
BRN_MINER_INTERVAL=30
BRN_ALLOW_SOLO_MINING=0
BRN_MIN_PEER_STABLE=1

# ============================================================
# 8) HTTP / API
# ============================================================
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_PORT=8080
BRN_EXPLORER_HOST=0.0.0.0
BRN_HTTP_THREADS=16

# CORS — vazio = só same-origin
BRN_CORS_ORIGIN=

# Proxy — vazio = sem proxy reverso
BRN_TRUSTED_PROXIES=
BRN_BEHIND_PROXY=0

# HTTPS — desligado (Tailscale já cifra o transporte)
BRN_HTTPS=0

# ============================================================
# 9) AUDIT
# ============================================================
BRN_AUDIT_ENABLED=1
BRN_AUDIT_LOG=audit.log
BRN_AUDIT_MAX_BYTES=52428800

# ============================================================
# 10) VERIFY
# ============================================================
BRN_SKIP_VERIFY=0
BRN_VERIFY_STRICT=0

# ============================================================
# 11) LOGS
# ============================================================
BRN_LOG_LEVEL=INFO

# ============================================================
# 12) MONGODB (opcional)
# ------------------------------------------------------------
# Deixe MONGO_PASS vazio para desabilitar.
# ============================================================
MONGO_USER=brunolabncaolivira_db_user
MONGO_PASS=N6aFVWeAtGsWXIVB
MONGO_HOST=cluster0.vbxjymy.mongodb.net
MONGO_DB=brn_analytics

# ============================================================
# 13) TAILSCALE
# ------------------------------------------------------------
# Setup automático desligado — você configura manualmente.
# ============================================================
TS_AUTH_KEY=
TS_API_KEY=
TS_TAILNET=
TS_HOSTNAME_PREFIX=brn-node

# ============================================================
# 14) PYTHON
# ============================================================
PYTHONUNBUFFERED=1
