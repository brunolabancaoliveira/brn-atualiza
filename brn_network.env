# ============================================================
# brn_network.env — Config do nó BRN (Máquina A - Ubuntu)
# ============================================================

# 1) SEGREDOS COMPARTILHADOS (IGUAIS NAS DUAS MÁQUINAS)
BRN_NETWORK_SECRET=9226edea8ba62bc1c6ae36883c0536c95b4c85642195465d6c4d9456abef20f9
BRN_NODE_PASSWORD=senha-no-temp-123
BRN_WALLET_SESSION_PASS=senha-forte-da-carteira-2026
BRN_WEB_PASS=senha-temp-123

# 2) ADMIN TOKEN
BRN_ADMIN_TOKEN=c745d36d524ea92148d8139731ad663f929fbbe08fb7f9b2234f9109fe1d2b24

# 3) DESCOBERTA DE PEERS
# ATENÇÃO: Coloque o IP Tailscale EXATO do Ubuntu aqui.
# Rode no terminal: tailscale ip -4
BRN_BOOTSTRAP_PEERS=100.111.253.8:6001

# Tracker desligado (evita travar o boot por causa do Render hibernando)
BRN_TRACKER=
BRN_RENDEZVOUS_URL=

# 4) MODO DE OPERAÇÃO
# MÁQUINA UBUNTU = 1 (Origem)
# MÁQUINA WINDOWS = 0 (Cliente)
BRN_IS_ORIGIN=1
BRN_ALL_MINERS=0
BRN_AUTO_MINE=0

# 5) CONSENSO
BRN_SYNC_BATCH=50
BRN_SYNC_BATCH_DELAY=0.06
BRN_SYNC_INTERVAL=5

# 6) P2P
BRN_P2P_PORT=6001
BRN_P2P_AUTH=optional
BRN_P2P_AUTH_WINDOW=30
BRN_P2P_NONCE_CACHE=10000
BRN_RATE_LIMIT=200
BRN_UPNP=0
BRN_TCP_TIMEOUT=10.0

# 7) MINERAÇÃO
BRN_MINER_INTERVAL=30
BRN_ALLOW_SOLO_MINING=0
BRN_MIN_PEER_STABLE=1

# 8) HTTP / API
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_PORT=8080
BRN_EXPLORER_HOST=0.0.0.0
BRN_HTTP_THREADS=16
BRN_CORS_ORIGIN=*
BRN_TRUSTED_PROXIES=
BRN_BEHIND_PROXY=0
BRN_HTTPS=0

# 9) AUDIT
BRN_AUDIT_ENABLED=1
BRN_AUDIT_LOG=audit.log
BRN_AUDIT_MAX_BYTES=52428800

# 10) VERIFY
BRN_SKIP_VERIFY=0
BRN_VERIFY_STRICT=0
BRN_LOG_LEVEL=INFO

# 14) PYTHON
PYTHONUNBUFFERED=1